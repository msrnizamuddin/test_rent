PORT=8000

# PostgreSQL connection string, e.g.
# postgres://user:password@host:5432/database?sslmode=require
DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# One-time secret required to create the first superadmin via
# POST /api/v1/auth/web/bootstrap-superadmin — remove/rotate after first use.
SETUP_SECRET=
